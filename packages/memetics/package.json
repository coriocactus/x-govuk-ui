{
  "name": "@x-govuk-ui/memetics",
  "description": "Charts for x-govuk-ui, built on Recharts.",
  "version": "0.2.1",
  "license": "MIT",
  "homepage": "https://x-govuk-ui.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coriocactus/x-govuk-ui.git",
    "directory": "packages/memetics"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "import": "./dist/lib/index.js"
    },
    "./styles.css": "./dist/lib/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/lib",
    "src",
    "CHANGELOG.md"
  ],
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "x-govuk-ui": "0.2.1"
  },
  "dependencies": {
    "recharts": "3.10.1"
  },
  "devDependencies": {
    "x-govuk-ui": "workspace:*"
  }
}
