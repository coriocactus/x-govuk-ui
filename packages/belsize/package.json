{
  "name": "@x-govuk-ui/belsize",
  "description": "A tiling layout for x-govuk-ui, built on react-mosaic.",
  "version": "0.2.0",
  "license": "MIT",
  "homepage": "https://x-govuk-ui.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coriocactus/x-govuk-ui.git",
    "directory": "packages/belsize"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "import": "./dist/lib/index.js"
    },
    "./styles.css": "./dist/lib/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/lib",
    "src"
  ],
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "x-govuk-ui": "0.2.0"
  },
  "dependencies": {
    "rdndmb-html5-to-touch": "9.0.0",
    "react-dnd": "16.0.1",
    "react-dnd-multi-backend": "9.0.0",
    "react-mosaic-component": "7.2.1"
  },
  "devDependencies": {
    "x-govuk-ui": "workspace:*"
  }
}
